 &GLOBAL
    PROJECT  pf5
    PRINT_LEVEL low
    RUN_TYPE GEO_OPT
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &MOTION
    &GEO_OPT
       MAX_ITER 50
    &END GEO_OPT
 &END MOTION
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS ATOMIC
          MAX_SCF 15
          EPS_SCF 1.E-7
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER DIIS
          &END OT
          &OUTER_SCF
            MAX_SCF 5
            EPS_SCF 1.E-7
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
    &END DFT
    &SUBSYS
       &CELL
         ABC      14.00000000    14.00000000    14.00000000
          PERIODIC NONE
       &END CELL
       &COORD
P           8.10291221     8.50000267     8.50000000
F           8.10302776     6.88703714     8.50000000
F           8.10302803    10.11296286     8.50000000
F           9.69446558     8.49999843     8.50000000
F           7.30553442     8.49999863     9.87761381
F           7.30553442     8.49999863     7.12238619
       &END COORD
       &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
       &END TOPOLOGY
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
