 &GLOBAL
    PROJECT  pdo2
    PRINT_LEVEL low
    RUN_TYPE GEO_OPT
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &MOTION
    &GEO_OPT
       MAX_ITER 50
       OPTIMIZER CG
       &CG
          &LINE_SEARCH
            &2PNT
            &END
          &END LINE_SEARCH
       &END CG
    &END GEO_OPT
 &END MOTION
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       LSD
       CHARGE            0
       MULTIPLICITY            5
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS ATOMIC
          MAX_SCF 30
          EPS_SCF 1.E-6
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER CG
          &END OT
          &OUTER_SCF
            MAX_SCF 3
            EPS_SCF 1.E-6
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
    &END DFT
    &SUBSYS
       &CELL
         ABC      15.00000000    15.00000000    15.00000000
          PERIODIC NONE
       &END CELL
       &COORD
Pd          8.50000000     8.50000000     8.50146363
O           6.61455762     8.50000000     8.49853637
O          10.38544238     8.50000000     8.49853637
       &END COORD
       &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
       &END TOPOLOGY
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
