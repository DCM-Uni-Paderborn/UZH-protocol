 &GLOBAL
    PROJECT  znme2
    PRINT_LEVEL low
    RUN_TYPE LINEAR_RESPONSE
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &EXT_RESTART
   RESTART_FILE_NAME znme2-1.restart
   RESTART_POS TRUE
 &END EXT_RESTART
 &FORCE_EVAL
    METHOD Quickstep
    &PROPERTIES
       &LINRES
          PRECONDITIONER FULL_ALL
          ENERGY_GAP  0.01
          MAX_ITER 50
          &POLAR
             DO_RAMAN T
             PERIODIC_DIPOLE_OPERATOR F
          &END POLAR
       &END LINRES
    &END PROPERTIES
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS RESTART
          MAX_SCF 10
          EPS_SCF 1.E-7
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
       &PRINT
          &MOMENTS
             PERIODIC F
             MAX_MOMENT 2
          &END MOMENTS
          &MO
             EIGVALS T
             &EACH
               QS_SCF 0
             &END EACH
             ADD_LAST NUMERIC
          &END MO
          &MO_CUBES
             NLUMO 1
             WRITE_CUBE F
          &END MO_CUBES
       &END PRINT
    &END DFT
    &SUBSYS
       &CELL
         ABC      16.00000000    16.00000000    16.00000000
          PERIODIC NONE
       &END CELL
       &COORD
C          10.94916196     9.13823611     8.90228712
C           7.05071716     9.13833167     8.90229455
H          11.35416289     9.88374606     8.18576142
H          11.35431466     8.14520438     8.61450676
H          11.35488583     9.38586478     9.90577711
H           6.64589047     9.78345240     8.09422289
H           6.64511417     9.51418075     9.86527843
H           6.64559855     8.11625394     8.74646200
Zn          8.99994683     9.13858279     8.90273140
       &END COORD
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
