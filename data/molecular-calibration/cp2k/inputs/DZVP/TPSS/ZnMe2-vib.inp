 &GLOBAL
    PROJECT  znme2
    PRINT_LEVEL low
    RUN_TYPE VIBRATIONAL_ANALYSIS
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &EXT_RESTART
   RESTART_FILE_NAME znme2-1.restart
   RESTART_POS TRUE
 &END EXT_RESTART
 &VIBRATIONAL_ANALYSIS
    INTENSITIES T
    NPROC_REP   -1
 &END VIBRATIONAL_ANALYSIS
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS RESTART
          MAX_SCF 15
          EPS_SCF 1.E-7
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER DIIS
          &END OT
          &OUTER_SCF
            MAX_SCF 5
            EPS_SCF 1.E-7
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
       &PRINT
          &MOMENTS
             PERIODIC F
             MAX_MOMENT 1
          &END MOMENTS
       &END PRINT
    &END DFT
    &SUBSYS
       &CELL
         ABC      16.00000000    16.00000000    16.00000000
          PERIODIC NONE
       &END CELL
       &COORD
C          10.94916196     9.13823611     8.90228712
C           7.05071716     9.13833167     8.90229455
H          11.35416289     9.88374606     8.18576142
H          11.35431466     8.14520438     8.61450676
H          11.35488583     9.38586478     9.90577711
H           6.64589047     9.78345240     8.09422289
H           6.64511417     9.51418075     9.86527843
H           6.64559855     8.11625394     8.74646200
Zn          8.99994683     9.13858279     8.90273140
       &END COORD
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
