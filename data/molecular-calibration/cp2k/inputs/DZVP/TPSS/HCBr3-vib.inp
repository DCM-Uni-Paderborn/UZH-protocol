 &GLOBAL
    PROJECT  hcbr3
    PRINT_LEVEL low
    RUN_TYPE VIBRATIONAL_ANALYSIS
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &EXT_RESTART
   RESTART_FILE_NAME hcbr3-1.restart
   RESTART_POS TRUE
 &END EXT_RESTART
 &VIBRATIONAL_ANALYSIS
    INTENSITIES T
    NPROC_REP   -1
 &END VIBRATIONAL_ANALYSIS
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS RESTART
          MAX_SCF 15
          EPS_SCF 1.E-7
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER DIIS
          &END OT
          &OUTER_SCF
            MAX_SCF 5
            EPS_SCF 1.E-7
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
       &PRINT
          &MOMENTS
             PERIODIC F
             MAX_MOMENT 1
          &END MOMENTS
       &END PRINT
    &END DFT
    &SUBSYS
       &CELL
         ABC      14.00000000    14.00000000    14.00000000
          PERIODIC NONE
       &END CELL
       &COORD
C           8.96701785     8.50000000     8.23261525
H           8.96701785     8.50000000     9.33348420
Br          9.90105356     6.88220270     7.66651580
Br          9.90105356    10.11779730     7.66651580
Br          7.09894644     8.50000000     7.66651580
       &END COORD
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
