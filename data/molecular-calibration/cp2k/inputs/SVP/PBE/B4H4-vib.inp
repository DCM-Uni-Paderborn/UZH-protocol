  &GLOBAL                                                                        
     PROJECT  b4h4                                                               
     PRINT_LEVEL low                                                             
     RUN_TYPE VIBRATIONAL_ANALYSIS                                               
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &EXT_RESTART                                                                   
    RESTART_FILE_NAME b4h4-1.restart                                             
    RESTART_POS TRUE                                                             
  &END EXT_RESTART                                                               
  &VIBRATIONAL_ANALYSIS                                                          
     INTENSITIES T                                                               
     NPROC_REP   -1                                                              
  &END VIBRATIONAL_ANALYSIS                                                      
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS RESTART                                                     
           MAX_SCF 15                                                            
           EPS_SCF 1.E-7                                                         
           &OT                                                                   
              PRECONDITIONER FULL_ALL                                            
              MINIMIZER DIIS                                                     
           &END OT                                                               
           &OUTER_SCF                                                            
             MAX_SCF 5                                                           
             EPS_SCF 1.E-7                                                       
           &END OUTER_SCF                                                        
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
        &PRINT                                                                   
           &MOMENTS                                                              
              PERIODIC F                                                         
              MAX_MOMENT 1                                                       
           &END MOMENTS                                                          
        &END PRINT                                                               
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      14.00000000    14.00000000    14.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 B           8.60068669     8.60068292     8.60068664                            
 B           7.39932119     8.60067903     7.39932111                            
 B           7.39931769     7.39931390     8.60068624                            
 B           8.60068809     7.39931212     7.39931578                            
 H           9.29739132     9.29738655     9.29739093                            
 H           6.70260868     9.29739161     6.70260854                            
 H           6.70261320     6.70260839     9.29739146                            
 H           9.29738694     6.70261071     6.70261772                            
        &END COORD                                                               
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
