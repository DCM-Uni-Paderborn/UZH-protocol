  &GLOBAL                                                                        
     PROJECT  bh3nh3                                                             
     PRINT_LEVEL low                                                             
     RUN_TYPE VIBRATIONAL_ANALYSIS                                               
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &EXT_RESTART                                                                   
    RESTART_FILE_NAME bh3nh3-1.restart                                           
    RESTART_POS TRUE                                                             
  &END EXT_RESTART                                                               
  &VIBRATIONAL_ANALYSIS                                                          
     INTENSITIES T                                                               
     NPROC_REP   -1                                                              
  &END VIBRATIONAL_ANALYSIS                                                      
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS RESTART                                                     
           MAX_SCF 15                                                            
           EPS_SCF 1.E-7                                                         
           &OT                                                                   
              PRECONDITIONER FULL_ALL                                            
              MINIMIZER DIIS                                                     
           &END OT                                                               
           &OUTER_SCF                                                            
             MAX_SCF 5                                                           
             EPS_SCF 1.E-7                                                       
           &END OUTER_SCF                                                        
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
        &PRINT                                                                   
           &MOMENTS                                                              
              PERIODIC F                                                         
              MAX_MOMENT 1                                                       
           &END MOMENTS                                                          
        &END PRINT                                                               
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      13.00000000    13.00000000    13.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 B           7.88533397     7.99999987     8.85229361                            
 N           7.88538196     7.99999988     7.20296392                            
 H           7.29163253     9.02843372     9.17649077                            
 H           6.92719895     7.99999987     6.82355658                            
 H           7.29162267     6.97156628     9.17651208                            
 H           8.36446445     7.17014726     6.82348793                            
 H           9.07280105     7.99999989     9.17644574                            
 H           8.36446444     8.82985249     6.82348792                            
        &END COORD                                                               
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
