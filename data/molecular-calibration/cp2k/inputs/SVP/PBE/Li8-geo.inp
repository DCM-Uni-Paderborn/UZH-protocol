  &GLOBAL                                                                        
     PROJECT  li8                                                                
     PRINT_LEVEL low                                                             
     RUN_TYPE GEO_OPT                                                            
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &MOTION                                                                        
     &GEO_OPT                                                                    
        MAX_ITER 50                                                              
     &END GEO_OPT                                                                
  &END MOTION                                                                    
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS ATOMIC                                                      
           MAX_SCF 15                                                            
           EPS_SCF 1.E-7                                                         
           &OT                                                                   
              PRECONDITIONER FULL_ALL                                            
              MINIMIZER DIIS                                                     
           &END OT                                                               
           &OUTER_SCF                                                            
             MAX_SCF 5                                                           
             EPS_SCF 1.E-7                                                       
           &END OUTER_SCF                                                        
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      14.00000000    14.00000000    14.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 Li          9.95063692     9.95064813     9.95055871                            
 Li          7.04935299     9.95068652     9.95059053                            
 Li          7.04930319     7.04931348     9.95063889                            
 Li          9.95069681     7.04933259     9.95061640                            
 Li          9.95058127     7.04944213     7.04936111                            
 Li          9.95054259     9.95055439     7.04940098                            
 Li          7.04945370     9.95057160     7.04938280                            
 Li          7.04941306     7.04946340     7.04937518                            
        &END COORD                                                               
        &TOPOLOGY                                                                
          &CENTER_COORDINATES                                                    
          &END CENTER_COORDINATES                                                
        &END TOPOLOGY                                                            
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
