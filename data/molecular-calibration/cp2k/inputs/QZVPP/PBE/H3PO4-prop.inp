  &GLOBAL                                                                        
     PROJECT  h3po4                                                              
     PRINT_LEVEL low                                                             
     RUN_TYPE LINEAR_RESPONSE                                                    
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &EXT_RESTART                                                                   
    RESTART_FILE_NAME h3po4-1.restart                                            
    RESTART_POS TRUE                                                             
  &END EXT_RESTART                                                               
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &PROPERTIES                                                                 
        &LINRES                                                                  
           PRECONDITIONER FULL_ALL                                               
           ENERGY_GAP  0.01                                                      
           MAX_ITER 50                                                           
           &POLAR                                                                
              DO_RAMAN T                                                         
              PERIODIC_DIPOLE_OPERATOR F                                         
           &END POLAR                                                            
        &END LINRES                                                              
     &END PROPERTIES                                                             
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS RESTART                                                     
           MAX_SCF 10                                                            
           EPS_SCF 1.E-7                                                         
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
        &PRINT                                                                   
           &MOMENTS                                                              
              PERIODIC F                                                         
              MAX_MOMENT 2                                                       
           &END MOMENTS                                                          
           &MO                                                                   
              EIGVALS T                                                          
              &EACH                                                              
                QS_SCF 0                                                         
              &END EACH                                                          
              ADD_LAST NUMERIC                                                   
           &END MO                                                               
           &MO_CUBES                                                             
              NLUMO 1                                                            
              WRITE_CUBE F                                                       
           &END MO_CUBES                                                         
        &END PRINT                                                               
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      15.00000000    15.00000000    15.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 P           7.96285062     8.49999998     8.11422991                            
 O           9.42203689     8.50000021     7.38885554                            
 O           7.23214096     9.76251190     7.38881498                            
 O           7.23214170     7.23748774     7.38881495                            
 O           7.96346389     8.50000001     9.61118505                            
 H          10.11089898     8.49999989     8.08154873                            
 H           6.88910106    10.36031503     8.08117309                            
 H           6.88910102     6.63968497     8.08117307                            
        &END COORD                                                               
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
