  &GLOBAL                                                                        
     PROJECT  kbr                                                                
     PRINT_LEVEL low                                                             
     RUN_TYPE GEO_OPT                                                            
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &MOTION                                                                        
     &GEO_OPT                                                                    
        MAX_ITER 20                                                              
     &END GEO_OPT                                                                
  &END MOTION                                                                    
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
           EPSFIT 1.E-6
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS ATOMIC                                                      
           NOTCONV_STOPALL
           MAX_SCF 30                                                            
           EPS_SCF 1.E-6                                                         
           &OT                                                                   
              PRECONDITIONER FULL_ALL                                            
              MINIMIZER DIIS                                                     
              STEPSIZE 0.1
              ENERGY_GAP 0.5
           &END OT                                                               
           &OUTER_SCF                                                            
             MAX_SCF 3                                                           
             EPS_SCF 1.E-6                                                       
           &END OUTER_SCF                                                        
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      14.00000000    14.00000000    14.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 K           9.00000000     9.00000000     7.54164718                            
 Br          9.00000000     9.00000000    10.45835282                            
        &END COORD                                                               
        &TOPOLOGY                                                                
          &CENTER_COORDINATES                                                    
          &END CENTER_COORDINATES                                                
        &END TOPOLOGY                                                            
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
