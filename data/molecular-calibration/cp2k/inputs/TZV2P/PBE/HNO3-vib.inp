 &GLOBAL
    PROJECT  hno3
    PRINT_LEVEL low
    RUN_TYPE VIBRATIONAL_ANALYSIS
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &EXT_RESTART
   RESTART_FILE_NAME hno3-1.restart
   RESTART_POS TRUE
 &END EXT_RESTART
 &VIBRATIONAL_ANALYSIS
    INTENSITIES T
    NPROC_REP   -1
 &END VIBRATIONAL_ANALYSIS
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS RESTART
          MAX_SCF 15
          EPS_SCF 1.E-7
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER DIIS
          &END OT
          &OUTER_SCF
            MAX_SCF 5
            EPS_SCF 1.E-7
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
       &PRINT
          &MOMENTS
             PERIODIC F
             MAX_MOMENT 1
          &END MOMENTS
       &END PRINT
    &END DFT
    &SUBSYS
       &CELL
         ABC      14.00000000    14.00000000    14.00000000
          PERIODIC NONE
       &END CELL
       &COORD
N           7.45587789     7.87639850     8.00000000
O           7.22305931     9.07132824     8.00000000
O           8.84735180     7.52021744     8.00000000
O           6.71418878     6.92867176     8.00000000
H           9.28581122     8.40249119     8.00000000
       &END COORD
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
