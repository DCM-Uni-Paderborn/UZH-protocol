 &GLOBAL
    PROJECT  s5
    PRINT_LEVEL low
    RUN_TYPE VIBRATIONAL_ANALYSIS
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &EXT_RESTART
   RESTART_FILE_NAME s5-1.restart
   RESTART_POS TRUE
 &END EXT_RESTART
 &VIBRATIONAL_ANALYSIS
    INTENSITIES T
    NPROC_REP   -1
 &END VIBRATIONAL_ANALYSIS
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS RESTART
          MAX_SCF 15
          EPS_SCF 1.E-7
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER DIIS
          &END OT
          &OUTER_SCF
            MAX_SCF 5
            EPS_SCF 1.E-7
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
       &PRINT
          &MOMENTS
             PERIODIC F
             MAX_MOMENT 1
          &END MOMENTS
       &END PRINT
    &END DFT
    &SUBSYS
       &CELL
         ABC      14.00000000    14.00000000    14.00000000
          PERIODIC NONE
       &END CELL
       &COORD
S           8.10676751     9.08127477     9.97608701
S           9.99843638     8.45826271     9.70262508
S           9.99844622     8.45826440     7.29738243
S           8.10678066     9.08126832     7.02391299
S           7.00155378     7.91872523     8.50000545
       &END COORD
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
