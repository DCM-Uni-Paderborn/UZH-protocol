 &GLOBAL
    PROJECT  feco5
    PRINT_LEVEL low
    RUN_TYPE GEO_OPT
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &MOTION
    &GEO_OPT
       MAX_ITER 50
    &END GEO_OPT
 &END MOTION
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS ATOMIC
          MAX_SCF 15
          EPS_SCF 1.E-7
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER DIIS
          &END OT
          &OUTER_SCF
            MAX_SCF 5
            EPS_SCF 1.E-7
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
    &END DFT
    &SUBSYS
       &CELL
         ABC      17.00000000    17.00000000    17.00000000
          PERIODIC NONE
       &END CELL
       &COORD
Fe         10.24064194     9.50000000     9.50000000
C          11.14213490     7.93856839     9.50000000
C          11.14213490    11.06143161     9.50000000
C           8.43765602     9.50000000     9.50000000
C          10.24064194     9.50000000    11.30352229
C          10.24064194     9.50000000     7.69647771
O          11.72192582     6.93434105     9.50000000
O          11.72192582    12.06565895     9.50000000
O           7.27807418     9.50000000     9.50000000
O          10.24064194     9.50000000    12.46046637
O          10.24064194     9.50000000     6.53953363
       &END COORD
       &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
       &END TOPOLOGY
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
