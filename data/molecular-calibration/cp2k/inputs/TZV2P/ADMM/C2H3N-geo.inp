 &GLOBAL
    PROJECT  c2h3n
    PRINT_LEVEL low
    RUN_TYPE GEO_OPT
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &MOTION
    &GEO_OPT
       MAX_ITER 50
    &END GEO_OPT
 &END MOTION
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS ATOMIC
          MAX_SCF 15
          EPS_SCF 1.E-7
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER DIIS
          &END OT
          &OUTER_SCF
            MAX_SCF 5
            EPS_SCF 1.E-7
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
    &END DFT
    &SUBSYS
       &CELL
         ABC      14.00000000    14.00000000    14.00000000
          PERIODIC NONE
       &END CELL
       &COORD
N           8.71058642     7.51620784     8.00000000
C           7.33175613     7.61726999     7.35427842
C           7.33175613     7.61726999     8.64572158
H           9.10307883     8.48379216     8.00000000
H           6.89692117     7.54364976     6.35460677
H           6.89692117     7.54364976     9.64539323
       &END COORD
       &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
       &END TOPOLOGY
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
