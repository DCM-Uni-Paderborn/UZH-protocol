 &GLOBAL
    PROJECT  hg2cl2
    PRINT_LEVEL low
    RUN_TYPE LINEAR_RESPONSE
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &EXT_RESTART
   RESTART_FILE_NAME hg2cl2-1.restart
   RESTART_POS TRUE
 &END EXT_RESTART
 &FORCE_EVAL
    METHOD Quickstep
    &PROPERTIES
       &LINRES
          PRECONDITIONER FULL_ALL
          ENERGY_GAP  0.01
          MAX_ITER 50
          &POLAR
             DO_RAMAN T
             PERIODIC_DIPOLE_OPERATOR F
          &END POLAR
       &END LINRES
    &END PROPERTIES
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS RESTART
          MAX_SCF 10
          EPS_SCF 1.E-7
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
       &PRINT
          &MOMENTS
             PERIODIC F
             MAX_MOMENT 2
          &END MOMENTS
          &MO
             EIGVALS T
             &EACH
               QS_SCF 0
             &END EACH
             ADD_LAST NUMERIC
          &END MO
          &MO_CUBES
             NLUMO 1
             WRITE_CUBE F
          &END MO_CUBES
       &END PRINT
    &END DFT
    &SUBSYS
       &CELL
         ABC      18.00000000    18.00000000    18.00000000
          PERIODIC NONE
       &END CELL
       &COORD
Hg         10.49952604     9.17700906    10.50000000
Hg         10.50047396    11.82218607    10.50000000
Cl         10.50004307     6.80917540    10.50000000
Cl         10.50001456    14.19082460    10.50000000
       &END COORD
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
