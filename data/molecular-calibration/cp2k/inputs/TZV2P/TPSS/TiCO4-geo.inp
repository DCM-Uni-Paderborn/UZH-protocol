 &GLOBAL
    PROJECT  tico4
    PRINT_LEVEL low
    RUN_TYPE GEO_OPT
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &MOTION
    &GEO_OPT
       MAX_ITER 50
    &END GEO_OPT
 &END MOTION
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS ATOMIC
          MAX_SCF 20
          EPS_SCF 1.E-6
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER CG
          &END OT
          &OUTER_SCF
            MAX_SCF 3
            EPS_SCF 1.E-6
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
    &END DFT
    &SUBSYS
       &CELL
         ABC      15.00000000    15.00000000    15.00000000
          PERIODIC NONE
       &END CELL
       &COORD
Ti          8.50000000     8.50000000     8.50000000
C           9.69175793     7.30824207     9.69175793
C           7.30824207     9.69175793     9.69175793
C           7.30824207     7.30824207     7.30824207
C           9.69175793     9.69175793     7.30824207
O          10.36425999     6.63574001    10.36425999
O           6.63574001    10.36425999    10.36425999
O           6.63574001     6.63574001     6.63574001
O          10.36425999    10.36425999     6.63574001
       &END COORD
       &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
       &END TOPOLOGY
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
