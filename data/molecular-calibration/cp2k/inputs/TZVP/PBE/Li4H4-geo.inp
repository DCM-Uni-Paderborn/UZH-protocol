 &GLOBAL
    PROJECT  li4h4
    PRINT_LEVEL low
    RUN_TYPE GEO_OPT
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &MOTION
    &GEO_OPT
       MAX_ITER 50
    &END GEO_OPT
 &END MOTION
 &FORCE_EVAL
    METHOD Quickstep
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS ATOMIC
          MAX_SCF 15
          EPS_SCF 1.E-7
          &OT
             PRECONDITIONER FULL_ALL
             MINIMIZER DIIS
          &END OT
          &OUTER_SCF
            MAX_SCF 5
            EPS_SCF 1.E-7
          &END OUTER_SCF
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
    &END DFT
    &SUBSYS
       &CELL
         ABC      13.00000000    13.00000000    13.00000000
          PERIODIC NONE
       &END CELL
       &COORD
Li          8.90002734     8.90002735     8.90002800
Li          7.09997266     8.90002737     7.09997242
Li          7.09997212     7.09997212     8.90002764
Li          8.90002736     7.09997267     7.09997241
H           7.01599581     8.98400396     8.98400411
H           7.01599569     7.01599570     7.01599589
H           8.98400399     7.01599581     8.98400411
H           8.98400431     8.98400430     7.01599595
       &END COORD
       &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
       &END TOPOLOGY
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
