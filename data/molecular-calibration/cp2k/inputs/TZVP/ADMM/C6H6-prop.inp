 &GLOBAL
    PROJECT  c6h6
    PRINT_LEVEL low
    RUN_TYPE LINEAR_RESPONSE
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &EXT_RESTART
   RESTART_FILE_NAME c6h6-1.restart
   RESTART_POS TRUE
 &END EXT_RESTART
 &FORCE_EVAL
    METHOD Quickstep
    &PROPERTIES
       &LINRES
          PRECONDITIONER FULL_ALL
          ENERGY_GAP  0.01
          MAX_ITER 50
          &POLAR
             DO_RAMAN T
             PERIODIC_DIPOLE_OPERATOR F
          &END POLAR
       &END LINRES
    &END PROPERTIES
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS RESTART
          MAX_SCF 10
          EPS_SCF 1.E-7
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
       &PRINT
          &MOMENTS
             PERIODIC F
             MAX_MOMENT 2
          &END MOMENTS
          &MO
             EIGVALS T
             &EACH
               QS_SCF 0
             &END EACH
             ADD_LAST NUMERIC
          &END MO
          &MO_CUBES
             NLUMO 1
             WRITE_CUBE F
          &END MO_CUBES
       &END PRINT
    &END DFT
    &SUBSYS
       &CELL
         ABC      16.00000000    16.00000000    16.00000000
          PERIODIC NONE
       &END CELL
       &COORD
C          10.40555427     8.99999315     9.00000000
C           9.70276322    10.21730360     9.00000000
C           8.29714360    10.21728177     9.00000000
C           7.59438471     8.99998684     9.00000000
C           8.29714162     7.78272726     9.00000000
C           9.70273809     7.78273295     9.00000000
H          11.50666632     8.99999713     9.00000000
H          10.25336805    11.17082085     9.00000000
H           7.74656483    11.17078216     9.00000000
H           6.49333368     8.99999721     9.00000000
H           7.74657754     6.82922721     9.00000000
H          10.25336277     6.82917915     9.00000000
       &END COORD
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
