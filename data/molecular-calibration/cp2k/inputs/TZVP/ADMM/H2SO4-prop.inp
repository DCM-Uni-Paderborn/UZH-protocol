 &GLOBAL
    PROJECT  h2so4
    PRINT_LEVEL low
    RUN_TYPE LINEAR_RESPONSE
    PREFERRED_DIAG_LIBRARY SL
 &END GLOBAL
 &EXT_RESTART
   RESTART_FILE_NAME h2so4-1.restart
   RESTART_POS TRUE
 &END EXT_RESTART
 &FORCE_EVAL
    METHOD Quickstep
    &PROPERTIES
       &LINRES
          PRECONDITIONER FULL_ALL
          ENERGY_GAP  0.01
          MAX_ITER 50
          &POLAR
             DO_RAMAN T
             PERIODIC_DIPOLE_OPERATOR F
          &END POLAR
       &END LINRES
    &END PROPERTIES
    &DFT
       CHARGE            0
       MULTIPLICITY            1
       BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
       POTENTIAL_FILE_NAME POTENTIAL_UZH
       &MGRID
           CUTOFF     720
           REL_CUTOFF  60
       &END MGRID
       &QS
          EPS_DEFAULT 1.E-14
       &END QS
       &SCF
          SCF_GUESS RESTART
          MAX_SCF 10
          EPS_SCF 1.E-7
       &END SCF
       &POISSON
          PERIODIC NONE
          POISSON_SOLVER MT
       &END POISSON
 @include xcdef
       &PRINT
          &MOMENTS
             PERIODIC F
             MAX_MOMENT 2
          &END MOMENTS
          &MO
             EIGVALS T
             &EACH
               QS_SCF 0
             &END EACH
             ADD_LAST NUMERIC
          &END MO
          &MO_CUBES
             NLUMO 1
             WRITE_CUBE F
          &END MO_CUBES
       &END PRINT
    &END DFT
    &SUBSYS
       &CELL
         ABC      15.00000000    15.00000000    15.00000000
          PERIODIC NONE
       &END CELL
       &COORD
S           8.49998570     8.50000130     8.70848447
O           9.77239581     8.49999911     9.43746580
O           7.22760419     8.49999910     9.43745854
O           8.49999358     9.67923399     7.56253420
O           8.49999357     7.32075585     7.56254398
H           8.49999351    10.52889556     8.05627853
H           8.49999351     6.47110444     8.05630306
       &END COORD
       &PRINT
          &ATOMIC_COORDINATES
          &END ATOMIC_COORDINATES
       &END PRINT
 @include kinddef
    &END SUBSYS
 &END FORCE_EVAL
