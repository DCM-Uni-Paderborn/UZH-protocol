  &GLOBAL                                                                        
     PROJECT  bef2o2h4                                                           
     PRINT_LEVEL low                                                             
     RUN_TYPE LINEAR_RESPONSE                                                    
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &EXT_RESTART                                                                   
    RESTART_FILE_NAME bef2o2h4-1.restart                                         
    RESTART_POS TRUE                                                             
  &END EXT_RESTART                                                               
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &PROPERTIES                                                                 
        &LINRES                                                                  
           PRECONDITIONER FULL_ALL                                               
           ENERGY_GAP  0.01                                                      
           MAX_ITER 50                                                           
           &POLAR                                                                
              DO_RAMAN T                                                         
              PERIODIC_DIPOLE_OPERATOR F                                         
           &END POLAR                                                            
        &END LINRES                                                              
     &END PROPERTIES                                                             
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS RESTART                                                     
           MAX_SCF 10                                                            
           EPS_SCF 1.E-7                                                         
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
        &PRINT                                                                   
           &MOMENTS                                                              
              PERIODIC F                                                         
              MAX_MOMENT 2                                                       
           &END MOMENTS                                                          
           &MO                                                                   
              EIGVALS T                                                          
              &EACH                                                              
                QS_SCF 0                                                         
              &END EACH                                                          
              ADD_LAST NUMERIC                                                   
           &END MO                                                               
           &MO_CUBES                                                             
              NLUMO 1                                                            
              WRITE_CUBE F                                                       
           &END MO_CUBES                                                         
        &END PRINT                                                               
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      15.00000000    15.00000000    15.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 Be          8.49999982     8.49999951     8.25287033                            
 F           8.50000006     7.14570842     7.65301939                            
 F           8.49999779     9.85429158     7.65302025                            
 O           9.92889061     8.49999951     9.34697765                            
 O           7.07111005     8.50000333     9.34698061                            
 H          10.44308059     9.28255135     9.05873543                            
 H           6.55691941     7.71744586     9.05873396                            
 H          10.44308051     7.71744824     9.05873382                            
 H           6.55692105     9.28254816     9.05873933                            
        &END COORD                                                               
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
