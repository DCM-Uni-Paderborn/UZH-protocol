  &GLOBAL                                                                        
     PROJECT  c2h6                                                               
     PRINT_LEVEL low                                                             
     RUN_TYPE LINEAR_RESPONSE                                                    
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &EXT_RESTART                                                                   
    RESTART_FILE_NAME c2h6-1.restart                                             
    RESTART_POS TRUE                                                             
  &END EXT_RESTART                                                               
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &PROPERTIES                                                                 
        &LINRES                                                                  
           PRECONDITIONER FULL_ALL                                               
           ENERGY_GAP  0.01                                                      
           MAX_ITER 50                                                           
           &POLAR                                                                
              DO_RAMAN T                                                         
              PERIODIC_DIPOLE_OPERATOR F                                         
           &END POLAR                                                            
        &END LINRES                                                              
     &END PROPERTIES                                                             
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS RESTART                                                     
           MAX_SCF 10                                                            
           EPS_SCF 1.E-7                                                         
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
        &PRINT                                                                   
           &MOMENTS                                                              
              PERIODIC F                                                         
              MAX_MOMENT 2                                                       
           &END MOMENTS                                                          
           &MO                                                                   
              EIGVALS T                                                          
              &EACH                                                              
                QS_SCF 0                                                         
              &END EACH                                                          
              ADD_LAST NUMERIC                                                   
           &END MO                                                               
           &MO_CUBES                                                             
              NLUMO 1                                                            
              WRITE_CUBE F                                                       
           &END MO_CUBES                                                         
        &END PRINT                                                               
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      13.00000000    13.00000000    13.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 C           7.49997145     7.50000248     8.26538546                            
 C           7.50000095     7.50000319     6.73460975                            
 H           7.49999938     8.53138339     8.67465675                            
 H           6.60668257     8.01564610     6.32552404                            
 H           6.60668075     6.98435424     8.67447607                            
 H           7.50000051     6.46861661     6.32534325                            
 H           8.39331925     6.98435281     8.67451473                            
 H           8.39331870     8.01564626     6.32552404                            
        &END COORD                                                               
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
