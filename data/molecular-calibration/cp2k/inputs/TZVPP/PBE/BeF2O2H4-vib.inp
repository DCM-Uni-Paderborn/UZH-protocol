  &GLOBAL                                                                        
     PROJECT  bef2o2h4                                                           
     PRINT_LEVEL low                                                             
     RUN_TYPE VIBRATIONAL_ANALYSIS                                               
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &EXT_RESTART                                                                   
    RESTART_FILE_NAME bef2o2h4-1.restart                                         
    RESTART_POS TRUE                                                             
  &END EXT_RESTART                                                               
  &VIBRATIONAL_ANALYSIS                                                          
     INTENSITIES T                                                               
     NPROC_REP   -1                                                              
  &END VIBRATIONAL_ANALYSIS                                                      
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS RESTART                                                     
           MAX_SCF 15                                                            
           EPS_SCF 1.E-7                                                         
           &OT                                                                   
              PRECONDITIONER FULL_ALL                                            
              MINIMIZER DIIS                                                     
           &END OT                                                               
           &OUTER_SCF                                                            
             MAX_SCF 5                                                           
             EPS_SCF 1.E-7                                                       
           &END OUTER_SCF                                                        
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
        &PRINT                                                                   
           &MOMENTS                                                              
              PERIODIC F                                                         
              MAX_MOMENT 1                                                       
           &END MOMENTS                                                          
        &END PRINT                                                               
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      15.00000000    15.00000000    15.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 Be          8.49999982     8.49999951     8.25287033                            
 F           8.50000006     7.14570842     7.65301939                            
 F           8.49999779     9.85429158     7.65302025                            
 O           9.92889061     8.49999951     9.34697765                            
 O           7.07111005     8.50000333     9.34698061                            
 H          10.44308059     9.28255135     9.05873543                            
 H           6.55691941     7.71744586     9.05873396                            
 H          10.44308051     7.71744824     9.05873382                            
 H           6.55692105     9.28254816     9.05873933                            
        &END COORD                                                               
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
