  &GLOBAL                                                                        
     PROJECT  cdme2                                                              
     PRINT_LEVEL low                                                             
     RUN_TYPE GEO_OPT                                                            
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &MOTION                                                                        
     &GEO_OPT                                                                    
        MAX_ITER 50                                                              
     &END GEO_OPT                                                                
  &END MOTION                                                                    
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS ATOMIC                                                      
           MAX_SCF 15                                                            
           EPS_SCF 1.E-7                                                         
           &OT                                                                   
              PRECONDITIONER FULL_ALL                                            
              MINIMIZER DIIS                                                     
           &END OT                                                               
           &OUTER_SCF                                                            
             MAX_SCF 5                                                           
             EPS_SCF 1.E-7                                                       
           &END OUTER_SCF                                                        
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      16.00000000    16.00000000    16.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 Cd          9.02816240     8.94130728     8.98996179                            
 C           9.03363565     8.94234624    11.12482487                            
 C           9.03446039     8.94230538     6.85889036                            
 H           9.58624505     9.82568477    11.50481358                            
 H           9.53503321     8.02964198    11.50629355                            
 H           8.00376305     8.97214789    11.53551080                            
 H           8.21628990     8.30623220     6.46448920                            
 H           9.99623695     8.55179440     6.46919586                            
 H           8.89358692     9.97035802     6.46789002                            
        &END COORD                                                               
        &TOPOLOGY                                                                
          &CENTER_COORDINATES                                                    
          &END CENTER_COORDINATES                                                
        &END TOPOLOGY                                                            
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
