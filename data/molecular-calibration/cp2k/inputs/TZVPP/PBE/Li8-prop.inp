  &GLOBAL                                                                        
     PROJECT  li8                                                                
     PRINT_LEVEL low                                                             
     RUN_TYPE LINEAR_RESPONSE                                                    
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &EXT_RESTART                                                                   
    RESTART_FILE_NAME li8-1.restart                                              
    RESTART_POS TRUE                                                             
  &END EXT_RESTART                                                               
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &PROPERTIES                                                                 
        &LINRES                                                                  
           PRECONDITIONER FULL_ALL                                               
           ENERGY_GAP  0.01                                                      
           MAX_ITER 50                                                           
           &POLAR                                                                
              DO_RAMAN T                                                         
              PERIODIC_DIPOLE_OPERATOR F                                         
           &END POLAR                                                            
        &END LINRES                                                              
     &END PROPERTIES                                                             
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS RESTART                                                     
           MAX_SCF 10                                                            
           EPS_SCF 1.E-7                                                         
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
        &PRINT                                                                   
           &MOMENTS                                                              
              PERIODIC F                                                         
              MAX_MOMENT 2                                                       
           &END MOMENTS                                                          
           &MO                                                                   
              EIGVALS T                                                          
              &EACH                                                              
                QS_SCF 0                                                         
              &END EACH                                                          
              ADD_LAST NUMERIC                                                   
           &END MO                                                               
           &MO_CUBES                                                             
              NLUMO 1                                                            
              WRITE_CUBE F                                                       
           &END MO_CUBES                                                         
        &END PRINT                                                               
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      14.00000000    14.00000000    14.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 Li          9.95063692     9.95064813     9.95055871                            
 Li          7.04935299     9.95068652     9.95059053                            
 Li          7.04930319     7.04931348     9.95063889                            
 Li          9.95069681     7.04933259     9.95061640                            
 Li          9.95058127     7.04944213     7.04936111                            
 Li          9.95054259     9.95055439     7.04940098                            
 Li          7.04945370     9.95057160     7.04938280                            
 Li          7.04941306     7.04946340     7.04937518                            
        &END COORD                                                               
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
