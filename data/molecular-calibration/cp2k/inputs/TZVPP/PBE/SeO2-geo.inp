  &GLOBAL                                                                        
     PROJECT  seo2                                                               
     PRINT_LEVEL low                                                             
     RUN_TYPE GEO_OPT                                                            
     PREFERRED_DIAG_LIBRARY SL                                                   
  &END GLOBAL                                                                    
  &MOTION                                                                        
     &GEO_OPT                                                                    
        MAX_ITER 50                                                              
        OPTIMIZER CG                                                             
        &CG                                                                      
           &LINE_SEARCH                                                          
             &2PNT                                                               
             &END                                                                
           &END LINE_SEARCH                                                      
        &END CG                                                                  
     &END GEO_OPT                                                                
  &END MOTION                                                                    
  &FORCE_EVAL                                                                    
     METHOD Quickstep                                                            
     &DFT                                                                        
        CHARGE            0                                                      
        MULTIPLICITY            1                                                
        BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH                                     
        POTENTIAL_FILE_NAME POTENTIAL_UZH                                        
        &MGRID                                                                   
            CUTOFF     720                                                       
            REL_CUTOFF  60                                                       
        &END MGRID                                                               
        &QS                                                                      
           METHOD GAPW
           EPS_DEFAULT 1.E-14                                                    
           EPSFIT 1.E-6
        &END QS                                                                  
        &SCF                                                                     
           SCF_GUESS ATOMIC                                                      
           MAX_SCF 20                                                            
           EPS_SCF 1.E-7                                                         
           &OT                                                                   
              PRECONDITIONER FULL_ALL                                            
              MINIMIZER DIIS                                                     
              STEPSIZE 0.1
           &END OT                                                               
           &OUTER_SCF                                                            
             MAX_SCF 4                                                           
             EPS_SCF 1.E-7                                                       
           &END OUTER_SCF                                                        
        &END SCF                                                                 
        &POISSON                                                                 
           PERIODIC NONE                                                         
           POISSON_SOLVER MT                                                     
        &END POISSON                                                             
  @include xcdef                                                                 
     &END DFT                                                                    
     &SUBSYS                                                                     
        &CELL                                                                    
          ABC      14.00000000    14.00000000    14.00000000                     
           PERIODIC NONE                                                         
        &END CELL                                                                
        &COORD                                                                   
 Se          8.00000000     8.00000000     8.43693614                            
 O           6.61747157     8.00000000     7.56306386                            
 O           9.38252843     8.00000000     7.56306386                            
        &END COORD                                                               
        &TOPOLOGY                                                                
          &CENTER_COORDINATES                                                    
          &END CENTER_COORDINATES                                                
        &END TOPOLOGY                                                            
        &PRINT                                                                   
           &ATOMIC_COORDINATES                                                   
           &END ATOMIC_COORDINATES                                               
        &END PRINT                                                               
  @include kinddef                                                               
     &END SUBSYS                                                                 
  &END FORCE_EVAL                                                                
